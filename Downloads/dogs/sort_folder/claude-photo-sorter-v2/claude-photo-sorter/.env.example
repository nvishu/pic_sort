# Copy this file to .env (or paste keys in the dashboard under Advanced > Add another AI).
# Every key is optional. Add as many FREE ones as you like: the sorter uses all of them
# together and switches to another when one hits its limit. .env is never committed.

GEMINI_API_KEY=        # free: https://aistudio.google.com/apikey
GROQ_API_KEY=          # free: https://console.groq.com/keys
MISTRAL_API_KEY=       # free "Experiment" plan: https://console.mistral.ai/api-keys
OPENROUTER_API_KEY=    # free models: https://openrouter.ai/keys

# Paid (only used when you pick them, or set AI_ALLOW_PAID=1 for Auto)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible server (LM Studio, vLLM, Together, DeepSeek...)
CUSTOM_BASE_URL=       # e.g. http://localhost:1234/v1
CUSTOM_MODEL=
CUSTOM_API_KEY=

# Optional tuning
# AI_PROVIDERS=gemini,groq   # fixed order instead of Auto
# AI_CONSENSUS=2             # two AIs must agree, a third breaks ties (slower, more accurate)
# AI_MODEL=                  # override the model of the first AI
# JEV_KEY=                   # TypeSafe Jev (paid, per file)
